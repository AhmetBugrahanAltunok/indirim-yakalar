# Bu dosya örnektir. Kopyala: .env  (ASLA commit edilmez)
# cp .env.example .env   /   Copy-Item .env.example .env

# --- Veritabanı ---
DATABASE_URL=postgresql+psycopg://indirim:indirim@localhost:5432/indirim_yakalar

# --- marketfiyati.org.tr iç API'si (Faz 1) ---
# Anahtar gerekmiyor. Ayrıntı: kasadaki Kaynaklar/Veri-Kaynaklari.md
MARKETFIYATI_BASE_URL=https://api.marketfiyati.org.tr

# Konum: arama bu koordinata yakın depolarla sınırlanır. ZORUNLU — varsayılanı yok.
# ÖNEMLİ: konum "depots" listesiyle uygulanır; koordinat tek başına yok sayılır.
# Kendi koordinatını yaz. Bulmak için: marketfiyati.org.tr > Konum Seçiniz > adresini ara.
# Aşağıdakiler YER TUTUCUDUR (Ankara/Kızılay) — kendi adresinle değiştirmezsen
# fiyatlar senin bölgenden gelmez.
LOCATION_LAT=39.9200
LOCATION_LON=32.8500
LOCATION_DISTANCE_KM=10

# Kaynağa saygılı çekim: istekler arası bekleme (saniye).
COLLECTOR_REQUEST_DELAY_SEC=2.0

# --- Analiz (Faz 2) ---
# Fiyat düşüşü eşiği: yüzde olarak. Bunun altındaki düşüş "indirim" sayılmaz.
PRICE_DROP_THRESHOLD_PCT=5.0

# --- LLM (Faz 3 — broşür okuma) ---
# Model adı koda sabitlenmez; her zaman buradan okunur.
LLM_PROVIDER=nvidia_nim
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
