# Bu dosya örnektir. Kopyala: .env  (ASLA commit edilmez)
# cp .env.example .env   /   Copy-Item .env.example .env

# --- Veritabanı ---
DATABASE_URL=postgresql+psycopg://indirim:indirim@localhost:5432/indirim_yakalar

# --- marketfiyati.org.tr iç API'si (Faz 1) ---
# Anahtar gerekmiyor. Ayrıntı: kasadaki Kaynaklar/Veri-Kaynaklari.md
MARKETFIYATI_BASE_URL=https://api.marketfiyati.org.tr

# Konum: arama bu koordinata yakın depolarla sınırlanır. ZORUNLU — varsayılanı yok.
# ÖNEMLİ: konum "depots" listesiyle uygulanır; koordinat tek başına yok sayılır.
# Kendi koordinatını yaz. Bulmak için: marketfiyati.org.tr > Konum Seçiniz > adresini ara.
# Aşağıdakiler YER TUTUCUDUR (Ankara/Kızılay) — kendi adresinle değiştirmezsen
# fiyatlar senin bölgenden gelmez.
LOCATION_LAT=39.9200
LOCATION_LON=32.8500
LOCATION_DISTANCE_KM=10

# Kaynağa saygılı çekim: istekler arası bekleme (saniye).
COLLECTOR_REQUEST_DELAY_SEC=2.0

# --- Günlük toplama zamanlayıcısı ---
# true yapınca uygulama açıldığında zamanlayıcı da başlar.
# Kapalıyken toplama yalnız elle tetiklenir (POST /pipeline/run/market-fiyati).
PIPELINE_AUTOSTART=false
# Platform öğlen civarı indeksliyor; sonrasında çekmek mantıklı.
PIPELINE_SCHEDULE_HOUR=13
PIPELINE_SCHEDULE_MINUTE=0

# --- Yedekleme ---
# Docker volume'ü iki kez silindi ve bir günün fiyat geçmişi kalıcı olarak gitti;
# platform geçmişe dönük fiyat vermiyor, kaçan gün geri gelmiyor.
# Yedek klasörü repo DIŞINDA olmalı: gerçek fiyat/depo verisi ve konum içerir.
# Varsayılan: repo'nun bir üst klasöründe indirim-yakalar-yedek/
# Değiştirmek istemiyorsan bu satırı YORUMDA BIRAK — boş değer varsayılanı
# devre dışı bırakır (pydantic boş dizeyi geçerli bir ayar sayar).
#BACKUP_DIR=D:\yedek\indirim-yakalar
BACKUP_CONTAINER=indirim-yakalar-db
BACKUP_RETENTION_DAYS=30

# Günlük koşunun WhatsApp mesajını yazacağı klasör (mesaj-YYYY-AA-GG.txt).
# Boş bırakılırsa yedeklerin yanına yazılır. Dosyayı aç, tümünü seç, kopyala.
MESSAGE_DIR=
# Mesaj başına ürün sayısı. Aşılırsa mesaj bölünür ve her sayfa ayrı dosya olur.
# Yüksek tutmak dosya sayısını azaltır; çok yüksek tutmak mesajı okunmaz yapar.
MESSAGE_ITEM_LIMIT=100

# --- Analiz (Faz 2) ---
# Fiyat düşüşü eşiği: yüzde olarak. Bunun altındaki düşüş "indirim" sayılmaz.
PRICE_DROP_THRESHOLD_PCT=5.0

# --- LLM (Faz 3 — broşür okuma) ---
# Model adı koda sabitlenmez; her zaman buradan okunur.
LLM_PROVIDER=nvidia_nim
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
